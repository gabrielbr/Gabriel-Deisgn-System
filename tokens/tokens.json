{
  "$comment": "Source of truth for every app's design tokens. Edit here, run scripts/gen_tokens.py, commit tokens + generated/ + DESIGN.md together. Schema: docs/tokens.md.",
  "name": "Gabriel Design System",
  "version": "0.2.1",
  "core": {
    "$comment": "Shared by every app. Every layer must include every core token (scripts/check_tokens.py enforces it).",
    "color": [
      {"name": "page", "value": {"light": "#F2F2F2", "dark": "#121214"}, "usage": "Screen background inside the mint frame.", "alias": {"pulseloop": "background"}},
      {"name": "surface", "value": {"light": "#FFFFFF", "dark": "#1C1B1F"}, "usage": "Header, tab bar, fields, cards, sheets.", "alias": {"pulseloop": "card"}},
      {"name": "ink", "value": {"light": "#17161A", "dark": "#F2F2F2"}, "usage": "Text, icons, secondary buttons, the recorder panel in light.", "alias": {"pulseloop": "textPrimary"}},
      {"name": "muted", "value": {"light": "#5E5D63", "dark": "#A8A7AD"}, "usage": "Meta text, captions, row values. 5.9:1 on page in light.", "alias": {"pulseloop": "textSecondary"}},
      {"name": "line", "value": {"light": "#E2E2E4", "dark": "#2C2B30"}, "usage": "Hairlines under rows, field and chip borders. Never for text.", "alias": {"pulseloop": "borderSubtle"}},
      {"name": "mint", "value": {"light": "#43F3B7", "dark": "#43F3B7"}, "usage": "The one primary action per screen, the title highlighter, the active tab pill, progress chips, the 4dp frame. Text on it is ink.", "alias": {"pulseloop": "MINT"}},
      {"name": "on-mint", "value": {"light": "#033423", "dark": "#033423"}, "usage": "Small text on a mint fill (chips). 9:1 on mint.", "alias": {"pulseloop": "onAccent"}},
      {"name": "coral", "value": {"light": "#E9554D", "dark": "#FF7A70"}, "usage": "Stop button fill and the recording dot. Text and icons on it use on-coral.", "alias": {"pulseloop": "danger"}},
      {"name": "coral-text", "value": {"light": "#B8322A", "dark": "#FF9A92"}, "usage": "Alert text, destructive button text and outline, on page, surface or coral-soft."},
      {"name": "coral-soft", "value": {"light": "#FDECEA", "dark": "#3A1A17"}, "usage": "Tint behind coral-text chips (Interrupted, Needs attention) so 12px text passes 4.5:1."}
    ],
    "spacing": [
      {"name": "space-1", "value": "4px", "usage": "Icon gap, chip padding."},
      {"name": "space-2", "value": "8px", "usage": "Inside a row, between label and value; under a caption."},
      {"name": "space-3", "value": "12px", "usage": "Between stacked lines in one item; caption to its rows."},
      {"name": "space-4", "value": "16px", "usage": "Row vertical padding; row inset inside a group; item vertical padding."},
      {"name": "space-6", "value": "24px", "usage": "Page gutter on phones; between items in a group."},
      {"name": "space-8", "value": "32px", "usage": "Page top under the header; page gutter on screens 600dp and wider."},
      {"name": "space-10", "value": "40px", "usage": "Above a section caption. The only gap between sections."},
      {"name": "space-12", "value": "48px", "usage": "Minimum control height and touch target."},
      {"name": "space-16", "value": "64px", "usage": "Tab bar and large Record button height."}
    ],
    "radius": [
      {"name": "radius-s", "value": "4px", "usage": "Buttons, chips, fields, monogram."},
      {"name": "radius-m", "value": "8px", "usage": "Cards and the recorder panel."},
      {"name": "radius-l", "value": "16px", "usage": "Pills: filter chips, tab pill, the app switch, sheet top corners."},
      {"name": "radius-round", "value": "999px", "usage": "Play button and slider thumb."}
    ],
    "size": [
      {"name": "frame", "value": "4px", "usage": "The mint border around every screen."},
      {"name": "hairline", "value": "1px", "usage": "Row dividers."}
    ],
    "motion": [
      {"name": "motion-standard", "value": "150ms", "usage": "Presses, colour changes, tab crossfades, small fades."},
      {"name": "motion-emphasised", "value": "250ms", "usage": "Screens opening and closing, content rising in, sheets, the frame fading back to mint."}
    ],
    "type": {
      "family": "\"Ubuntu Mono\", ui-monospace, Menlo, monospace",
      "faces": ["ubuntu_mono.ttf (400)", "ubuntu_mono_bold.ttf (700)", "ubuntu_mono_bold_italic.ttf (700 italic)"],
      "floor": 12
    }
  },
  "layers": {
    "uikit": {
      "$comment": "The Java Views kit: NotTheOmiAIApp/ui-kit (br.gabriel.ui). Used by GVoice, GMind, GMoney, GHealth and GDesk. Order below is the order of the generated UiTokens.java.",
      "consumers": ["GVoice (app/)", "GMind (sentient/)", "GMoney and GHealth (suite/, money/, health/)", "GDesk (desk/)"],
      "themes": ["light", "dark"],
      "color": [
        "@page", "@surface", "@ink", "@muted", "@line", "@mint", "@on-mint", "@coral", "@coral-text", "@coral-soft",
        {"name": "panel", "pair": true, "value": {"light": "#17161A", "dark": "#000000"}, "usage": "The recorder panel while recording, and the player."},
        {"name": "on-panel", "pair": true, "value": {"light": "#FFFFFF", "dark": "#F2F2F2"}, "usage": "Text on panel."},
        {"name": "on-panel-muted", "value": {"light": "#B9B8BE", "dark": "#A8A7AD"}, "usage": "Secondary text on panel."},
        {"name": "snackbar", "value": "{ink}", "usage": "Snackbar ground; its text is page, its action is snackbar-action."},
        {"name": "on-coral", "pair": true, "value": {"light": "#17161A", "dark": "#17161A"}, "usage": "Label and icon on a coral fill (Stop). 5.0:1 light, 7.1:1 dark; white was 3.6:1."},
        {"name": "snackbar-action", "pair": true, "value": {"light": "#43F3B7", "dark": "#0A7A55"}, "usage": "The snackbar's action. Mint on the dark light-theme ground, deep mint on the light dark-theme ground (4.8:1)."}
      ],
      "type": [
        {"name": "Display", "styles": [
          {"name": "display", "fontSize": "30px", "lineHeight": "36px", "fontWeight": 700},
          {"name": "timer", "fontSize": "56px", "lineHeight": "64px", "fontWeight": 700, "letterSpacing": "-1px"}
        ]},
        {"name": "Text", "styles": [
          {"name": "title", "fontSize": "22px", "lineHeight": "28px", "fontWeight": 700},
          {"name": "label", "fontSize": "16px", "lineHeight": "22px", "fontWeight": 700},
          {"name": "body", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400},
          {"name": "body-small", "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400},
          {"name": "meta", "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400},
          {"name": "caption", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 700, "letterSpacing": "0.5px", "textTransform": "uppercase"}
        ]}
      ],
      "spacing": ["@space-1", "@space-2", "@space-3", "@space-4", "@space-6", "@space-8", "@space-10", "@space-12", "@space-16"],
      "radius": ["@radius-s", "@radius-m", "@radius-l", "@radius-round"],
      "size": [
        "@frame",
        {"name": "header", "value": "56px", "usage": "Header height."},
        {"name": "tabbar", "value": "64px", "usage": "Tab bar height."},
        {"name": "button", "value": "52px", "usage": "Primary, secondary and destructive buttons; fields."},
        {"name": "monogram", "value": "32px", "usage": "The GV_ / GM_ mark in the header."},
        "@hairline",
        {"name": "row-min", "value": "56px", "usage": "Minimum height of a row."}
      ],
      "motion": [
        "@motion-standard", "@motion-emphasised",
        {"name": "motion-frame-lap", "value": "1500ms", "usage": "One lap of the loading line around the frame."}
      ]
    },
    "pulseloop": {
      "$comment": "PulseLoopAndroid, Jetpack Compose (com.pulseloop.ui.theme). Dark only. alias.pulseloop is the PulseColors property each token must match (scripts/drift.py).",
      "consumers": ["PulseLoop (PulseLoopAndroid/app)"],
      "themes": ["dark"],
      "color": [
        "@page", "@surface", "@ink", "@muted", "@line", "@mint", "@on-mint", "@coral", "@coral-text", "@coral-soft",
        {"name": "page-raised", "value": {"dark": "#161619"}, "usage": "Material surface behind cards (secondaryBackground).", "alias": {"pulseloop": "secondaryBackground"}},
        {"name": "surface-soft", "value": {"dark": "#242328"}, "usage": "A card inside a card, pressed rows.", "alias": {"pulseloop": "cardSoft"}},
        {"name": "surface-elevated", "value": {"dark": "#2C2B30"}, "usage": "Highest container (surfaceContainerHighest).", "alias": {"pulseloop": "elevated"}},
        {"name": "muted-2", "value": {"dark": "#8E8D94"}, "usage": "Tertiary text. 5.2:1 on surface, 4.75:1 on surface-soft; do not lighten.", "alias": {"pulseloop": "textMuted"}},
        {"name": "line-strong", "value": {"dark": "#3D3C42"}, "usage": "Outlines that must read as a boundary.", "alias": {"pulseloop": "borderStrong"}},
        {"name": "mint-soft", "value": {"dark": "#2E43F3B7"}, "usage": "Mint at 18%: primaryContainer. Prefer the dither over this wash.", "alias": {"pulseloop": "accentSoft"}},
        {"name": "success", "value": {"dark": "#4CC97A"}, "usage": "Good, in range, done, connected. Its own green: mint means 'tap here'.", "alias": {"pulseloop": "success"}},
        {"name": "warning", "value": {"dark": "#FFC46B"}, "usage": "Watch, borderline, connecting.", "alias": {"pulseloop": "warning"}},
        {"name": "info", "value": {"dark": "#5AD8F0"}, "usage": "Neutral information.", "alias": {"pulseloop": "info"}},
        {"name": "metric-steps", "value": {"dark": "#9BEA6B"}, "usage": "Steps. Leaf green, distinct from mint.", "alias": {"pulseloop": "steps"}},
        {"name": "metric-heart-rate", "value": {"dark": "#FF7A70"}, "usage": "Heart rate.", "alias": {"pulseloop": "heartRate"}},
        {"name": "metric-spo2", "value": {"dark": "#5AD8F0"}, "usage": "Blood oxygen.", "alias": {"pulseloop": "spo2"}},
        {"name": "metric-sleep", "value": {"dark": "#9A8CFF"}, "usage": "Sleep.", "alias": {"pulseloop": "sleep"}},
        {"name": "metric-calories", "value": {"dark": "#FF9A5C"}, "usage": "Calories.", "alias": {"pulseloop": "calories"}},
        {"name": "metric-distance", "value": {"dark": "#5BA8FF"}, "usage": "Distance.", "alias": {"pulseloop": "distance"}},
        {"name": "metric-battery", "value": {"dark": "#A7F3D0"}, "usage": "Ring battery.", "alias": {"pulseloop": "battery"}},
        {"name": "metric-stress", "value": {"dark": "#FF9A5C"}, "usage": "Stress.", "alias": {"pulseloop": "stress"}},
        {"name": "metric-hrv", "value": {"dark": "#B59CFF"}, "usage": "Heart-rate variability.", "alias": {"pulseloop": "hrv"}},
        {"name": "metric-temperature", "value": {"dark": "#3FD0C8"}, "usage": "Skin temperature.", "alias": {"pulseloop": "temperature"}},
        {"name": "metric-blood-pressure", "value": {"dark": "#FF7FA8"}, "usage": "Blood pressure.", "alias": {"pulseloop": "bloodPressure"}},
        {"name": "metric-blood-sugar", "value": {"dark": "#FFC46B"}, "usage": "Blood glucose.", "alias": {"pulseloop": "bloodSugar"}},
        {"name": "metric-fatigue", "value": {"dark": "#C98CFF"}, "usage": "Fatigue.", "alias": {"pulseloop": "fatigue"}},
        {"name": "metric-drinks", "value": {"dark": "#E38FB5"}, "usage": "Drinks. Wine rose.", "alias": {"pulseloop": "drinks"}},
        {"name": "zone-low", "value": {"dark": "#5BA8FF"}, "usage": "Below the normal range.", "alias": {"pulseloop": "zoneBlue"}},
        {"name": "zone-good", "value": {"dark": "#4CC97A"}, "usage": "In range. Same as success.", "alias": {"pulseloop": "zoneMint"}},
        {"name": "zone-normal", "value": {"dark": "#5AD8F0"}, "usage": "Normal, acceptable.", "alias": {"pulseloop": "zoneCyan"}},
        {"name": "zone-borderline", "value": {"dark": "#FFC46B"}, "usage": "Borderline, watch.", "alias": {"pulseloop": "zoneAmber"}},
        {"name": "zone-borderline-soft", "value": {"dark": "#FFDDA6"}, "usage": "Soft amber step.", "alias": {"pulseloop": "zoneSoftAmber"}},
        {"name": "zone-elevated", "value": {"dark": "#FF9A5C"}, "usage": "Elevated, stage 1.", "alias": {"pulseloop": "zoneOrange"}},
        {"name": "zone-high", "value": {"dark": "#FF7A70"}, "usage": "High, concerning.", "alias": {"pulseloop": "zoneRed"}},
        {"name": "zone-critical", "value": {"dark": "#FF4B3E"}, "usage": "Critical.", "alias": {"pulseloop": "zoneCritical"}},
        {"name": "stage-deep", "value": {"dark": "#6352F0"}, "usage": "Deep sleep. 3.3:1 on surface (graphic, not text).", "alias": {"pulseloop": "stageDeep"}},
        {"name": "stage-light", "value": {"dark": "#9A8CFF"}, "usage": "Light sleep.", "alias": {"pulseloop": "stageLight"}},
        {"name": "stage-rem", "value": {"dark": "#5AD8F0"}, "usage": "REM. Cyan, not mint, so it doesn't read as 'tap here'.", "alias": {"pulseloop": "stageRem"}},
        {"name": "stage-awake", "value": {"dark": "#FFC46B"}, "usage": "Awake.", "alias": {"pulseloop": "stageAwake"}},
        {"name": "fairy-accent", "value": {"dark": "#FF8FC7"}, "usage": "Fairy mode (a private easter egg): replaces mint.", "alias": {"pulseloop": "FairyMode.accent"}},
        {"name": "fairy-accent-soft", "value": {"dark": "#2EFF8FC7"}, "usage": "Fairy mode: replaces mint-soft.", "alias": {"pulseloop": "FairyMode.accentSoft"}},
        {"name": "fairy-on-accent", "value": {"dark": "#3D0A26"}, "usage": "Fairy mode: replaces on-mint. 7.9:1.", "alias": {"pulseloop": "FairyMode.onAccent"}},
        {"name": "fairy-rem", "value": {"dark": "#FFB3DA"}, "usage": "Fairy mode: replaces stage-rem.", "alias": {"pulseloop": "FairyMode.rem"}}
      ],
      "type": [
        {"name": "Scale", "styles": [
          {"name": "eyebrow", "fontSize": "12px", "lineHeight": "1.3em", "fontWeight": 500, "letterSpacing": "1px", "textTransform": "uppercase"},
          {"name": "label", "fontSize": "12px", "lineHeight": "1.3em", "fontWeight": 400},
          {"name": "body", "fontSize": "14px", "lineHeight": "1.4em", "fontWeight": 400},
          {"name": "title", "fontSize": "16px", "lineHeight": "1.3em", "fontWeight": 700},
          {"name": "headline", "fontSize": "28px", "lineHeight": "1.2em", "fontWeight": 700}
        ]}
      ],
      "typeScale": [12, 14, 16, 20, 24, 28, 32, 40],
      "spacing": ["@space-1", "@space-2", "@space-3", "@space-4", "@space-6", "@space-8", "@space-10", "@space-12", "@space-16"],
      "radius": ["@radius-s", "@radius-m", "@radius-l", "@radius-round"],
      "size": [
        "@frame", "@hairline",
        {"name": "content-max", "value": "720px", "usage": "Tab content cap from 600dp, where the tabs move to a navigation rail."}
      ],
      "motion": [
        "@motion-standard", "@motion-emphasised",
        {"name": "motion-fill", "value": "900ms", "usage": "A ring, gauge or bar filling from empty (sweepIn)."},
        {"name": "motion-screen", "value": "750ms", "usage": "The diagonal dither wipe between screens. 420ms read as a flicker."}
      ],
      "dither": {
        "bayer4": [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5],
        "steps": 16,
        "cell": "1dp, at least 2 device pixels",
        "outline": {"color": "{page}", "width": "1.5dp"},
        "usage": "Where a colour would be tinted down (a wash behind a chip, the area under a chart), draw it at full strength through the 4x4 Bayer matrix: lighter means fewer dots. Text and icons on dither get a page-coloured outline."
      }
    }
  },
  "contrast": [
    {"fg": "ink", "bg": "page", "min": 4.5, "layers": ["uikit", "pulseloop"]},
    {"fg": "ink", "bg": "surface", "min": 4.5, "layers": ["uikit", "pulseloop"]},
    {"fg": "muted", "bg": "page", "min": 4.5, "layers": ["uikit", "pulseloop"]},
    {"fg": "muted", "bg": "surface", "min": 4.5, "layers": ["uikit", "pulseloop"]},
    {"fg": "on-mint", "bg": "mint", "min": 4.5, "layers": ["uikit", "pulseloop"]},
    {"fg": "coral-text", "bg": "page", "min": 4.5, "layers": ["uikit"]},
    {"fg": "coral-text", "bg": "surface", "min": 4.5, "layers": ["uikit"]},
    {"fg": "coral-text", "bg": "coral-soft", "min": 4.5, "layers": ["uikit"]},
    {"fg": "on-panel", "bg": "panel", "min": 4.5, "layers": ["uikit"]},
    {"fg": "on-panel-muted", "bg": "panel", "min": 4.5, "layers": ["uikit"]},
    {"fg": "page", "bg": "snackbar", "min": 4.5, "layers": ["uikit"]},
    {"fg": "muted-2", "bg": "surface", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "muted-2", "bg": "surface-soft", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "success", "bg": "surface", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "warning", "bg": "surface", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "coral", "bg": "surface", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "info", "bg": "surface", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "stage-deep", "bg": "surface", "min": 3.0, "layers": ["pulseloop"], "note": "Graphic (a chart bar), WCAG 1.4.11."},
    {"fg": "fairy-on-accent", "bg": "fairy-accent", "min": 4.5, "layers": ["pulseloop"]},
    {"fg": "on-coral", "bg": "coral", "min": 4.5, "layers": ["uikit"], "note": "Stop label (was white, audit A-1)."},
    {"fg": "snackbar-action", "bg": "snackbar", "min": 4.5, "layers": ["uikit"], "note": "Snackbar action (was mint, audit A-2)."}
  ]
}
